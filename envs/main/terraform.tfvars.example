# 로컬 plan용. terraform.tfvars로 복사해 채운다(커밋 금지). CI는 레포 변수를 TF_VAR_*로 넘긴다.
domain_name                  = "santacut.example"
ssh_public_key               = "ssh-ed25519 AAAA... santacut-deploy"
ssh_allowed_cidrs            = ["203.0.113.10/32"]
bedrock_model_id             = "anthropic.claude-haiku-5-5-REPLACE"
